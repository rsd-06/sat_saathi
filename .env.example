SATSAATHI_MODE=online
POSTGRES_USER=satsaathi
POSTGRES_PASSWORD=satsaathi_dev_password
POSTGRES_DB=satsaathi
DATABASE_URL=postgresql+asyncpg://satsaathi:satsaathi_dev_password@postgres:5432/satsaathi
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/data/storage
# Model weights. Separate from storage: rasters are user data, weights are
# part of the build. A model with no weights here reports itself unavailable.
MODELS_DIR=/data/models
TILER_URL=http://tiler:80

# inline runs jobs inside the API process (no broker needed);
# celery hands them to a worker. Compose sets this to celery for the API.
JOB_DISPATCH=inline

# Google sign-in. Leave these empty to turn it off: the button
# disappears and the API refuses Google tokens rather than skipping
# the audience check. Get them from the Google Cloud console under
# APIs & Services > Credentials > OAuth client ID (Web application),
# with http://localhost:3000/api/auth/google/callback as an
# authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
