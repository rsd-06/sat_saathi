      "patch": {
        "tags": [
          "assets"
        ],
        "summary": "Set Bands",
        "description": "Apply a sensor preset or an explicit mapping.\n\nRoles decide which indices are computable, so they are never inferred from\nband order \u2014 this endpoint is the only way one gets set.",
        "operationId": "set_bands_api_v1_assets__asset_id__bands_patch",
        "parameters": [
